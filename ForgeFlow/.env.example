# Run scripts/setup.py to create random local credentials.
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://forgeflow:YOUR_PASSWORD@127.0.0.1:55432/forgeflow
# Blank workspace/runtime values are not supported: omit to use local defaults.
# WORKSPACE_ROOT=C:/path/to/generated-projects
# RUNTIME_ROOT=C:/path/to/private-runtime

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BACKUP_API_KEY=
# Optional, comma-separated model names from the same provider.
LLM_FALLBACK_MODELS=
LLM_TIMEOUT=180
LLM_MAX_TOKENS=8000
LLM_RETRIES=1
LLM_MIN_INTERVAL=3
# DeepSeek only: disable extra reasoning to leave more output room for code.
DEEPSEEK_THINKING=false
MAX_ITERATIONS=3
MAX_AGENT_STEPS=6
MAX_MODEL_CALLS_PER_RUN=12
MAX_TOKENS_PER_RUN=80000
# Set a model budget to -1 to disable it; LLM_MAX_TOKENS=-1 uses provider defaults.
MAX_RUN_SECONDS=900
# MAX_ITERATIONS, MAX_AGENT_STEPS and MAX_RUN_SECONDS also accept -1 (unlimited).
# Unlimited runs can continue spending until completion, error, or user cancellation.

# Alternative: OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/free
# LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=

EXECUTION_MODE=docker
# Optional hosted deployment (keep these empty/default for the local installation):
PUBLIC_ORIGIN=
PREVIEW_ORIGIN=
REGISTRATION_ENABLED=true
# Optional second profile; credentials never appear in the model selector:
GPT_API_KEY=
GPT_ENABLED=false
GPT_MODEL=gpt-6-astra
GPT_BASE_URL=https://api.modelbridge.tech/openai/v1
GPT_TOKEN_PARAMETER=max_completion_tokens
GPT_SEND_TEMPERATURE=false
GPT_REASONING_EFFORT=low
# For trusted use without Docker: EXECUTION_MODE=local and DATABASE_URL=sqlite:///platform.db
# Changing the database URL does not migrate an existing database.
SANDBOX_IMAGE=forgeflow-runner:local
COMMAND_TIMEOUT=120
DEMO_START_TIMEOUT=40
# Browser interactions run in a fresh headless browser after the preview starts.
# Windows: msedge or chrome. For bundled Chromium, leave channel empty and run:
# python -m playwright install chromium
BROWSER_CHANNEL=msedge
BROWSER_TIMEOUT=120
# With no remote URL, each project gets a real local bare Git backup.
GIT_REMOTE_URL=
ENABLE_GIT_PUSH=false
GITHUB_TOKEN=
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
